# Copiá este archivo como .env y completá los valores. El .env NO se sube al repositorio.

# production oculta los errores técnicos; development los muestra y habilita /dev-mails.php
APP_ENV=production
APP_NAME="Alto Rosario Shopping"
# URL pública SIN barra final. Los links de los emails se arman con este valor.
APP_URL=https://tu-dominio.com

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tp_shopping
DB_USER=
DB_PASS=

# SMTP para emails (Gmail con contraseña de aplicación, Brevo, Mailtrap, etc.).
# Si MAIL_HOST queda vacío, los emails se guardan en storage/mails (solo para pruebas locales).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# tls (STARTTLS, puerto 587) | ssl (puerto 465) | none
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=avisos@tu-dominio.com
MAIL_FROM_NAME="Alto Rosario Shopping"
# Recibe las consultas del formulario de contacto
ADMIN_EMAIL=admin@tu-dominio.com

# Reglas de categoría: descuentos aceptados necesarios para subir de categoría
USOS_PARA_MEDIUM=3
USOS_PARA_PREMIUM=6
